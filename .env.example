# PrintHub backend environment configuration (example)
# Copy to .env and fill in real local values. .env is NOT committed.

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# SQLite database file path (relative to backend/ working dir)
DATABASE_PATH=./data/printhub.sqlite

# JWT secret: replace with a long random string for any real use
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=2h
